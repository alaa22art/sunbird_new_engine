
#----------------------------------------------------------------------------------------------------------#
spring.datasource.url=jdbc:postgresql://localhost:5433/certacure_middleware2
#----------------------------------------------------------------------------------------------------------#
spring.datasource.username= postgres
spring.datasource.password= root
spring.datasource.platform											= postgres
spring.datasource.driver-class-name									= org.postgresql.Driver
spring.datasource.hikari.connection-timesout					    = 60000
spring.datasource.type                                              = com.zaxxer.hikari.HikariDataSource
spring.datasource.hikari.maximum-pool-size							= 50

spring.jpa.database													= POSTGRESQL
spring.jpa.hibernate.naming.implicit-strategy						= com.certacure.core.common.helper.CustomNamingStrategy
spring.jpa.hibernate.cache.region.factory_class						= org.hibernate.cache.ehcache.EhCacheRegionFactory
spring.jpa.properties.hibernate.jdbc.time_zone 						= UTC
spring.jpa.properties.hibernate.current_session_context_class		= org.springframework.orm.hibernate5.SpringSessionContext

spring.jpa.properties.hibernate.show_sql							= false
spring.jpa.properties.hibernate.use_sql_comments					= false
spring.jpa.properties.hibernate.format_sql							= false 

spring.jpa.properties.hibernate.generate_statistics                 = false
spring.jpa.properties.org.hibernate.envers.default_schema			= public
spring.jpa.properties.org.hibernate.envers.revision_field_name		= REV
spring.jpa.properties.org.hibernate.envers.revision_type_field_name	= REVTYPE

logging.level.org.hibernate.SQL										= DEBUG
logging.pattern.console=%clr(%d{yy-MM-dd E HH:mm:ss.SSS}){blue} %clr(%-5p) %clr(${PID}){faint} %clr(---){faint} %clr([%8.15t]){cyan} %clr(%-40.40logger{0}){blue} %clr(:){red} %clr(%m){faint}%n
logging.level.org.hibernate.type.descriptor.sql.BasicBinder			= TRACE

spring.cache.ehcache.config											= classpath:ehcache.xml
spring.jackson.serialization.write-dates-as-timestamps				= false

#Email props
spring.mail.host                                                    = smtp.gmail.com
spring.mail.password                                                = Certa@2021
spring.mail.port                                                    = 587
spring.mail.default-encoding                                        = UTF-8
spring.mail.properties.mail.smtp.auth                               = true
spring.mail.properties.mail.smtp.starttls.enable                    = true
spring.mail.transport.protocol                                      = smtp
spring.mail.username                                                = support@certacure.com

server.servlet.contextPath											= /miw
server.port 														= 8055

spring.servlet.multipart.max-file-size		   						= 20MB
spring.servlet.multipart.max-request-size	   						= 20MB

server.tomcat.max-http-header-size 									= 20MB
#maximum size of the whole post request (forms only)
server.tomcat.max-http-post-size									= 2MB
#maximum size of a request body (forms only)
server.tomcat.max-swallow-size										= 2MB

spring.mvc.static-path-pattern										= /**
spring.mvc.view.suffix                                              = .html

system.website.base 												= http://localhost:${server.port}
system.website.url          										= ${system.website.base}/miw
system.website.services          									= ${system.website.url}/services/
